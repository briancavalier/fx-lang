{
  "name": "vscode-fx",
  "displayName": "fx",
  "description": "VS Code language support for fx.",
  "version": "0.1.0",
  "publisher": "briancavalier",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:fx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fx",
        "aliases": [
          "fx"
        ],
        "extensions": [
          ".fx"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.3"
  }
}
